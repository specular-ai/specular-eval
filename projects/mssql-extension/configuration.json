      "idDefinitionSites": {
        "headings": {
          "enabled": true,
          "levels": [
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "mode": "regex",
          "pattern": "^(?:Research )?(?:\\d+[a-z]?\\. )?(?<id>D\\d+[a-z]?|Decision \\d+)(?=\\s*[:.—–/])"
        },
        "tables": {
          "enabled": true,
          "column": "ID",
          "mode": "exact"
        },
        "lists": {
          "enabled": false,
          "types": [
            "unordered"
          ],
          "mode": "start"
