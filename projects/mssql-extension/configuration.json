          "pattern": "specs/*"
        }
      ],
      "onlyInScopes": true,
      "definitionPaths": [
        "specs/*/spec.md"
      ]
    },
    {
      "key": "stories",
      "name": "User stories",
      "role": "requirement",
      "idScopes": [
        {
