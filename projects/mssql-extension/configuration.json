    {
      "key": "contracts",
      "name": "Contracts",
      "role": "design",
      "idScopes": [
        {
          "pattern": "specs/068-login-routing-unification*"
        }
      ],
      "onlyInScopes": true,
      "definitionPaths": [
        "specs/*/contracts"
      ]
    },
    {
      "key": "features",
      "name": "Feature specifications",
      "role": "requirement",
      "derive": {
        "pattern": "specs/{feature}/spec.md"
      }
    }
  ],
  "rules": [
    {
      "key": "fr",
      "category": "requirements",
      "pattern": "\\b(?:FR|NFR)-\\d+[a-z]?\\b"
    },
    {
      "key": "sc",
      "category": "success",
      "prefix": "SC"
    },
    {
      "key": "story",
      "category": "stories",
      "pattern": "\\bUser Story \\d+\\b"
    },
    {
      "key": "story-alias",
      "category": "stories",
      "pattern": "\\bUS-?(?<n>\\d+)\\b",
      "id": "User Story {n:int}"
    },
    {
      "key": "task",
      "category": "tasks",
      "pattern": "\\bT\\d+[a-zA-Z]?\\b"
    },
    {
      "key": "decision",
      "category": "decisions",
      "pattern": "\\b(?:D\\d+[a-z]?|Decision \\d+)\\b"
    },
    {
      "key": "research",
      "category": "research",
      "pattern": "\\bR\\d+\\b"
    },
    {
      "key": "contract",
      "category": "contracts",
      "pattern": "\\bC\\d+\\b"
    }
  ],
  "idDefinitionSites": {
    "headings": {
      "enabled": true,
      "levels": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "mode": "start"
    },
    "tables": {
      "enabled": true,
      "column": "ID",
      "mode": "exact"
    },
    "lists": {
      "enabled": true,
      "types": [
        "unordered"
      ],
      "mode": "start"
    },
    "paragraphs": {
      "enabled": false,
      "mode": "start"
    }
  },
  "statusSites": {
    "checkboxes": {
      "enabled": true,
      "markers": {
        "x": "Done",
        "X": "Done",
        " ": "Open",
        "-": "In progress",
        "~": "Deferred"
      }
    },
    "paragraphs": {
      "enabled": true,
      "mode": "regex",
      "label": "Status:",
      "listItems": true,
      "pattern": "\\bStatus\\s*:\\s*(?<status>(?:EXECUTED AND CLOSED|[Ii]n progress|[A-Za-z]+)(?: \\d{4}-\\d{2}-\\d{2})?)"
    },
    "tables": {
      "enabled": true,
      "mode": "full",
      "column": "Status"
    },
    "headings": {
      "enabled": true,
      "mode": "regex",
      "pattern": "(?:—|–|:)\\s*\\*{0,2}(?<status>DONE|CLOSED|SHIPPED|IMPLEMENTED|IN PROGRESS)\\b"
    }
  },
  "statuses": [
    {
      "name": "Draft",
      "rules": [
        {
          "mode": "startsWith",
          "value": "Draft"
        }
      ]
    },
    {
      "name": "Done",
      "rules": [
        {
          "mode": "regex",
          "value": "^(?:Done|Complete|Implemented|Shipped)\\b"
        }
      ]
    },
    {
      "name": "Closed",
      "rules": [
        {
          "mode": "regex",
          "value": "^(?:Closed|Executed and closed)\\b"
        }
      ]
    },
    {
      "name": "Open"
    },
    {
      "name": "In progress"
    },
    {
      "name": "Ready",
      "rules": [
        {
          "mode": "exact",
          "value": "ready"
        }
      ]
    },
    {
      "name": "Deferred"
    },
    {
      "name": "Proposed"
    },
    {
      "name": "Revised",
      "rules": [
        {
          "mode": "startsWith",
          "value": "revised"
        }
      ]
    }
  ],
  "dates": {
    "rules": [
      {
        "key": "status-date",
        "site": "status",
        "enabled": true,
        "pattern": "(?<date>\\d{4}-\\d{2}-\\d{2})"
      },
      {
        "key": "list-entry",
        "site": "list-entry",
        "enabled": true,
        "kind": "entry"
      },
      {
        "key": "heading",
        "site": "heading",
        "enabled": true,
        "pattern": "(?<date>\\d{4}-\\d{2}-\\d{2})",
        "kind": "milestone"
      },
      {
        "key": "created",
        "site": "field",
        "enabled": true,
        "pattern": "(?<date>\\d{4}-\\d{2}-\\d{2})",
        "label": "Created",
        "kind": "milestone"
      },
      {
        "key": "date",
        "site": "field",
        "enabled": true,
        "pattern": "(?<date>\\d{4}-\\d{2}-\\d{2})",
        "label": "Date",
        "kind": "milestone"
      }
    ],
    "exclude": [
      "website/versioned_docs",
      ".claude",
      ".specify/templates"
    ]
  }
}