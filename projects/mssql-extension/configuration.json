          "enabled": true,
          "levels": [
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "mode": "regex",
          "pattern": "^(?:Phase \\d+(?:\\.\\d+)?: )?(?<id>User Story \\d+)\\b"
        },
        "tables": {
          "enabled": true,
          "column": "ID",
          "mode": "exact"
        },
        "lists": {
          "enabled": false,
          "types": [
            "unordered",
            "ordered"
          ],
          "mode": "start"
        },
        "paragraphs": {
          "enabled": false,
          "mode": "start"
        }
      }
    },
    {
      "key": "tasks",
      "name": "Tasks",
      "role": "task",
      "idScopes": [
        {
          "pattern": "specs/*/tasks.md"
        }
      ],
      "onlyInScopes": true,
      "definitionPaths": [
        "specs/*/tasks.md"
      ],
      "idDefinitionSites": {
        "headings": {
          "enabled": true,
          "levels": [
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "mode": "start"
        },
        "tables": {
          "enabled": true,
          "column": "ID",
          "mode": "exact"
        },
        "lists": {
          "enabled": true,
          "types": [
            "unordered",
            "ordered"
          ],
          "mode": "start",
          "checkboxOnly": true
        },
        "paragraphs": {
          "enabled": false,
          "mode": "start"
        }
      }
    },
