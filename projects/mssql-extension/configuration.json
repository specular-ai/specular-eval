{
  "version": 1,
  "categories": [
    {
      "key": "requirements",
      "name": "Requirements",
      "role": "requirement",
      "idScopes": [
        {
          "pattern": "specs/*"
        }
      ],
      "onlyInScopes": true,
      "definitionPaths": [
        "specs/*/spec.md"
      ]
    },
    {
      "key": "success",
      "name": "Success criteria",
      "role": "requirement",
      "idScopes": [
