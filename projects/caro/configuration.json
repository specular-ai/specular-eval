        {
          "pattern": "kitty-specs/016-*"
        },
        {
          "pattern": "kitty-specs/017-*"
        },
        {
          "pattern": "kitty-specs/022-*"
        },
        {
          "pattern": "kitty-specs/025-*"
        },
        {
          "pattern": "kitty-specs/026-*"
        }
      ],
      "onlyInScopes": true,
      "definitionPaths": [
        "kitty-specs/*/tasks.md"
      ],
      "idDefinitionSites": {
        "headings": {
          "enabled": true,
          "levels": [
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "mode": "regex",
          "pattern": "^(?:Work Package )?(?<id>WP\\d+)\\b"
        },
        "tables": {
          "enabled": false,
          "column": "ID",
          "mode": "exact"
        },
        "lists": {
          "enabled": false,
          "types": [
