        "specs/*/test_cases.md"
      ]
    },
    {
      "key": "shortstories",
      "name": "ID User Stories",
      "role": "requirement",
      "idScopes": [
        {
          "pattern": "specs/*"
        },
        {
          "pattern": "kitty-specs/027-issue-281-add*"
        },
        {
          "pattern": "docs/PRD-ast-parser-shell-validation.md"
        }
      ],
      "onlyInScopes": true,
      "definitionPaths": [
        "specs/*/spec.md",
        "kitty-specs/027-issue-281-add/spec.md",
        "docs/PRD-ast-parser-shell-validation.md"
      ]
    },
    {
