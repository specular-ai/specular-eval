            5,
            6
          ],
          "mode": "start"
        },
        "tables": {
          "enabled": true,
          "column": "Story",
          "mode": "exact"
        },
        "lists": {
          "enabled": false,
          "types": [
            "unordered",
            "ordered"
          ],
          "mode": "start"
        },
