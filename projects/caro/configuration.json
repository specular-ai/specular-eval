        "tables": {
          "enabled": true,
          "column": "ID",
          "mode": "exact"
        },
        "lists": {
          "enabled": true,
          "types": [
            "unordered",
            "ordered"
          ],
          "mode": "start",
          "checkboxOnly": true
        },
        "paragraphs": {
          "enabled": false,
          "mode": "start"
        }
      }
    },
    {
