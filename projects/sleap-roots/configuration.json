  "rules": [
    {
      "key": "task",
      "category": "tasks",
      "pattern": "^\\d+(?:\\.\\d+)+[a-z]?(?=\\s)"
    },
    {
      "key": "plan_task",
      "category": "plan_tasks",
      "pattern": "\\bTask \\d+(?:\\.\\d+)*\\b"
    },
    {
      "key": "decision",
      "category": "decisions",
      "pattern": "\\b(?:D\\d+[a-z]?|Decision \\d+)\\b"
    },
    {
      "key": "cc",
      "category": "constraints",
      "prefix": "CC"
    },
    {
      "key": "cr",
      "category": "reviews",
      "pattern": "\\bCR\\d*-\\d+\\b"
    },
    {
      "key": "risk",
      "category": "risks",
      "pattern": "^R\\d+(?=\\.)"
    },
    {
      "key": "pipeline_decision",
      "category": "pipeline_decisions",
      "pattern": "\\bD\\d+[a-z]?\\b"
    }
  ],
  "statusSites": {
    "checkboxes": {
      "enabled": true,
      "markers": {
        "x": "Done",
        "X": "Done",
        " ": "Open",
        "-": "In progress"
      }
    },
    "paragraphs": {
      "enabled": true,
      "mode": "literal",
      "label": "Status:",
      "listItems": true
    },
    "tables": {
      "enabled": true,
      "mode": "full",
      "column": "Status"
    },
